{
  "name": "tvp-mobile-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start",
    "android": "node node_modules/expo/bin/cli start --android",
    "ios": "node node_modules/expo/bin/cli start --ios",
    "web": "node node_modules/expo/bin/cli start --web",
    "fix:expo-modules": "node -e \"const fs=require('fs');const path=require('path');const p=path.join('node_modules','expo-modules-core');if(fs.existsSync(p)){fs.rmSync(p,{recursive:true,force:true});console.log('Removed expo-modules-core');}\" && npm install expo-modules-core@3.0.29"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "expo": "~54.0.0",
    "expo-file-system": "~19.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~7.0.3",
    "expo-modules-core": "^3.0.29",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "private": true,
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
